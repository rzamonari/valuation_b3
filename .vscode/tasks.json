{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Pipeline: 1. Bronze (ingestão)",
			"type": "shell",
			"command": "uv",
			"args": ["run", "python", "-m", "pipeline.ingestao"],
			"group": "build"
		},
		{
			"label": "Pipeline: 2. Silver (transformação)",
			"type": "shell",
			"command": "uv",
			"args": ["run", "python", "-m", "pipeline.transformacao"],
			"group": "build"
		},
		{
			"label": "Pipeline: 3. Gold (materialização)",
			"type": "shell",
			"command": "uv",
			"args": ["run", "python", "-m", "pipeline.materializacao"],
			"group": "build"
		},
		{
			"label": "Pipeline: completo",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Pipeline: 1. Bronze (ingestão)",
				"Pipeline: 2. Silver (transformação)",
				"Pipeline: 3. Gold (materialização)"
			],
			"group": "build"
		},
		{
			"label": "Painel (Streamlit)",
			"type": "shell",
			"command": "uv",
			"args": ["run", "streamlit", "run", "app.py"],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Testes com cobertura",
			"type": "shell",
			"command": "uv",
			"args": ["run", "pytest", "--cov"],
			"group": "test"
		},
		{
			"label": "Ruff (lint)",
			"type": "shell",
			"command": "uv",
			"args": ["run", "ruff", "check", "."],
			"group": "test"
		}
	]
}
