{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Rename aggregation specifications and references",
			"type": "shell",
			"command": "git",
			"args": [
				"mv",
				".venv/.specs/sql_indicadores.md",
				".venv/.specs/marts_agregacao_indicadores.md"
			],
			"group": "build"
		},
		{
			"label": "Rename aggregation specs",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Rename-Item -LiteralPath .venv/.specs/sql_indicadores.md -NewName marts_agregacao_indicadores.md; Rename-Item -LiteralPath .venv/.specs/sql_rank.md -NewName marts_agregacao_rank.md"
			],
			"group": "build"
		},
		{
			"label": "Update aggregation spec references",
			"type": "shell",
			"command": "python",
			"args": [
				"-c",
				"from pathlib import Path\nfor p in Path('.').rglob('*.md'):\n    try: text=p.read_text(encoding='utf-8')\n    except UnicodeDecodeError: continue\n    updated=text.replace('sql_indicadores.md','marts_agregacao_indicadores.md').replace('sql_rank.md','marts_agregacao_rank.md')\n    if updated != text: p.write_text(updated,encoding='utf-8')"
			],
			"group": "build"
		},
		{
			"label": "Apply spec reference renames",
			"type": "shell",
			"command": "python",
			"args": [
				"C:\\Users\\Usuario\\.copilot\\session-state\\049959c6-8fec-40c2-bcc9-147b71ecdbe4\\files\\update_spec_refs.py"
			],
			"group": "build"
		}
	]
}